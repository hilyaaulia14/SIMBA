<mxfile host="65bd71144e"><diagram id="cdm_simba_main" name="CONCEPTUAL DATA MODEL (CDM)"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_banner" value="&lt;b&gt;CONCEPTUAL DATA MODEL (CDM) SISTEM INFORMASI SIMBA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Balai Pemasyarakatan (Bapas) Kelas I Banjarmasin - Model Data Konseptual (Notasi PowerDesigner)&lt;/font&gt;" style="text;html=1;strokeColor=#00AAAA;fillColor=#E5FFFF;align=center;verticalAlign=middle;rounded=1;fontSize=13;fontColor=#000000;strokeWidth=1.5;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="10" width="1540" height="42" as="geometry" /></mxCell><mxCell id="legend_box" value="&lt;b&gt;PANDUAN NOTASI KARDINALITAS (POWERDESIGNER):&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;Relasi 1:1 (One-to-One):&lt;/b&gt; Kedua ujung garis bertanda garis tegak lurus &lt;b&gt;||&lt;/b&gt; (tanpa cakar gagak). Contoh pada SIMBA: &lt;i&gt;atur_jadwal &amp;#8596; klien (menerima 1:1)&lt;/i&gt; dan &lt;i&gt;jadwal_bimbingan &amp;#8596; kehadiran_klien (memverifikasi 1:1)&lt;/i&gt;.&lt;br&gt;&amp;#8226; &lt;b&gt;Relasi 1:M (One-to-Many):&lt;/b&gt; Ujung sisi '1' bertanda garis tegak lurus &lt;b&gt;||&lt;/b&gt;, dan ujung sisi 'M' bertanda cakar gagak &lt;b&gt;&gt;-|&lt;/b&gt;. Contoh: &lt;i&gt;role (1) &amp;#8594; pegawai (M)&lt;/i&gt;, &lt;i&gt;pegawai (1) &amp;#8594; surat (M)&lt;/i&gt;, &lt;i&gt;klien (1) &amp;#8594; jadwal_bimbingan (M)&lt;/i&gt;, dll." style="text;html=1;strokeColor=#00AAAA;fillColor=#E5FFFF;align=left;verticalAlign=middle;rounded=1;fontSize=11;fontColor=#000000;strokeWidth=1.5;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="80" y="945" width="1540" height="46" as="geometry" /></mxCell><mxCell id="ent_atur_jadwal" value="atur_j